! =====================================================================
! branchline.net - BỘ GHÉP BRANCH-LINE (QUADRATURE HYBRID) 3 dB, 4 CỔNG
! =====================================================================
! Bốn đoạn dây lambda/4 tại f0 = 2.4 GHz tạo thành vòng kín:
!   - hai nhánh NGANG (series arms) : Z0/sqrt(2) = 35.355 ohm
!   - hai nhánh DỌC   (shunt arms)  : Z0        = 50 ohm
!
!        P1 ---- TL_A (35.355) ---- P2
!        |                           |
!      TL_D (50)                  TL_B (50)
!        |                           |
!        P4 ---- TL_C (35.355) ---- P3
!
! Lý thuyết tại f0 (Pozar - quadrature hybrid):
!   S = -1/sqrt(2) * [[0, j, 1, 0], [j, 0, 0, 1], [1, 0, 0, j], [0, 1, j, 0]]
!   -> cổng 2 = THẲNG   (|S21| = 0.7071, pha  -90 độ)
!      cổng 3 = GHÉP    (|S31| = 0.7071, pha -180 độ) -> vuông pha với cổng 2
!      cổng 4 = CÁCH LY (S41 = 0);  S11 = 0 (phối hợp hoàn toàn)
! Mỗi nút có 3 chân (1 cổng ngoài + 2 đoạn dây) -> 4 mối nối T tự động.
! Mạng 4 cổng -> kiểm chứng thuật toán với số cổng > 3.
! =====================================================================

FREQ START=1.4G STOP=3.4G POINTS=201

PORT 1 P1
PORT 2 P2
PORT 3 P3
PORT 4 P4

TLINE TL_A P1 P2 Z0=35.355339 EL=90 F0=2.4G
TLINE TL_C P4 P3 Z0=35.355339 EL=90 F0=2.4G
TLINE TL_D P1 P4 Z0=50        EL=90 F0=2.4G
TLINE TL_B P2 P3 Z0=50        EL=90 F0=2.4G
