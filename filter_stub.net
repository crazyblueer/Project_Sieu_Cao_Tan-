! =====================================================================
! filter_stub.net - LỌC THÔNG DẢI DÙNG STUB LAMBDA/4 (PHÂN BỐ)
! =====================================================================
! Ba stub ngắn mạch lambda/4 (tại f0 = 2.4 GHz) cách nhau bởi hai đoạn
! dây lambda/4 50 ohm. Stub ngắn mạch lambda/4 -> hở mạch tại f0
! (không ảnh hưởng), nhưng ngắn mạch tại 2*f0 và DC -> đặc tuyến
! THÔNG DẢI quanh f0.
!
!   P1 --+-- TL1(50,90d) --+-- TL2(50,90d) --+-- P2
!        |                 |                 |
!      SB1(80,90d,short)  SB2(60,90d,short)  SB3(80,90d,short)
!
! Mục đích: kiểm chứng phần tử PHÂN BỐ (TLINE + STUB TERM=short) trên
! toàn dải tần, và mối nối T tại 3 nút.
! =====================================================================

FREQ START=1.0G STOP=4.0G POINTS=301

PORT 1 n1
PORT 2 n3

STUB  SB1 n1       Z0=80 EL=90 F0=2.4G TERM=short
TLINE TL1 n1 n2    Z0=50 EL=90 F0=2.4G
STUB  SB2 n2       Z0=60 EL=90 F0=2.4G TERM=short
TLINE TL2 n2 n3    Z0=50 EL=90 F0=2.4G
STUB  SB3 n3       Z0=80 EL=90 F0=2.4G TERM=short
